{
  "manifest_version": 3,
  "name": "UnFake",
  "version": "0.1.0",
  "description": "AI-assisted, in-context misinformation verification. Select text or crop images to verify claims against fact-checking sources.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "offscreen",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/text-selection.js",
        "content/image-crop.js",
        "content/content.js"
      ],
      "css": ["content/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/tesseract.min.js",
        "lib/worker.min.js",
        "lib/tesseract-core-lstm.wasm.js",
        "lib/tessdata/*",
        "offscreen/offscreen.html",
        "offscreen/offscreen.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
