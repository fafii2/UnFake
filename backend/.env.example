# UnFake Backend Configuration
# Copy this file to .env and fill in the values.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS — allowed origins for the browser extension
# Chrome extensions use chrome-extension://<extension-id> as their origin.
# Add your extension's ID after loading it in Chrome.
ALLOWED_ORIGINS=chrome-extension://your-extension-id-here,http://localhost:3000

# Optional live services. Keep keys here, never in extension files.
# Tavily provides live search. Gemini evaluates retrieved evidence and can embed it.
TAVILY_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# none: offline keyword/exact search; gemini: cloud vectors; local: optional local model.
# After choosing a provider, run: python -m scripts.seed_archive --embed
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PROVIDER_TIMEOUT_SECONDS=12
VERIFY_TIMEOUT_SECONDS=25
# ARCHIVE_PATH=C:/path/to/archive.sqlite3
# CALIBRATION_PATH=C:/path/to/calibration.json
